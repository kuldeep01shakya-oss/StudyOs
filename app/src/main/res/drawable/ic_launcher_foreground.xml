<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Glowing outer ring -->
    <path
        android:pathData="M54,28 A26,26 0 1,1 53.99,28"
        android:strokeWidth="2.5"
        android:strokeColor="#6366F1"
        android:fillColor="#00000000" />
    
    <!-- Timer / Focus tick marks -->
    <path
        android:pathData="M54,22 L54,26 M86,54 L82,54 M54,86 L54,82 M22,54 L26,54"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeColor="#06B6D4" />

    <!-- Open Book Base Silhouette -->
    <path
        android:pathData="M34,64 Q54,60 54,68 Q54,60 74,64 L74,48 Q54,44 54,52 Q54,44 34,48 Z"
        android:strokeWidth="1.8"
        android:strokeLineJoin="round"
        android:strokeColor="#818CF8">
        <aapt:attr name="android:fillColor">
            <gradient
                android:angle="45"
                android:endColor="#4F46E5"
                android:startColor="#06B6D4"
                android:type="linear" />
        </aapt:attr>
    </path>

    <!-- Central Lightning Spark / Focus Bolt -->
    <path
        android:pathData="M55,34 L47,48 L53,48 L51,60 L61,46 L55,46 Z"
        android:fillColor="#38BDF8"
        android:strokeWidth="1"
        android:strokeColor="#FFFFFF" />
</vector>

